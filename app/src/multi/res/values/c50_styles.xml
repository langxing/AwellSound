<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="rbtn_mode_type">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textColor">#748AA2</item>
        <item name="android:textSize">@dimen/c50_mode_text_size</item>
    </style>

    <style name="style_mode_item">
        <item name="android:layout_width">270dp</item>
        <item name="android:layout_height">@dimen/c50_mode_item_height</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/c50_mode_item_padding</item>
        <item name="android:layout_marginTop">@dimen/c50_mode_item_margin_top</item>
        <item name="android:background">@drawable/selector_mode_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="c50_dsp_seekBar_style">
        <item name="android:thumbOffset">0dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:progressDrawable">@drawable/c50_seekbar_bg</item>
        <item name="android:thumb">@drawable/c50_dsp_increase_thumb</item>
        <item name="android:maxHeight">12dp</item>
        <item name="android:minHeight">12dp</item>
        <item name="android:max">28</item>
        <item name="android:padding">10dp</item>
        <item name="seekBarRotation">CW270</item>
    </style>

</resources>
