<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/btn_drive_left"
        style="@style/style_mode_item"
        android:layout_marginStart="20dp"
        android:paddingHorizontal="@dimen/c50_mode_item_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_drive_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_chair"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            style="@style/rbtn_mode_type"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/btn_drive_left"
            app:drawableStartCompat="@drawable/ic_driver" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/selector_group_bg"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_drive_right"
        style="@style/style_mode_item"
        android:paddingHorizontal="@dimen/c50_mode_item_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_drive_center"
        app:layout_constraintStart_toStartOf="@+id/btn_drive_left"
        app:layout_constraintTop_toBottomOf="@+id/btn_drive_left">

        <TextView
            style="@style/rbtn_mode_type"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/btn_drive_right"
            app:drawableStartCompat="@drawable/ic_drive_right" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/selector_group_bg"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_drive_center"
        style="@style/style_mode_item"
        android:paddingHorizontal="@dimen/c50_mode_item_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_drive_rear"
        app:layout_constraintStart_toStartOf="@+id/btn_drive_left"
        app:layout_constraintTop_toBottomOf="@+id/btn_drive_right">

        <TextView
            style="@style/rbtn_mode_type"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/btn_drive_center"
            app:drawableStartCompat="@drawable/ic_drive_center" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/selector_group_bg"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_drive_rear"
        style="@style/style_mode_item"
        android:paddingHorizontal="@dimen/c50_mode_item_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_drive_user1"
        app:layout_constraintStart_toStartOf="@+id/btn_drive_left"
        app:layout_constraintTop_toBottomOf="@+id/btn_drive_center">

        <TextView
            style="@style/rbtn_mode_type"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/btn_drive_rear"
            app:drawableStartCompat="@drawable/ic_drive_rear" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/selector_group_bg"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_drive_user1"
        style="@style/style_mode_item"
        android:paddingHorizontal="@dimen/c50_mode_item_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_drive_user2"
        app:layout_constraintStart_toStartOf="@+id/btn_drive_left"
        app:layout_constraintTop_toBottomOf="@+id/btn_drive_rear">

        <TextView
            style="@style/rbtn_mode_type"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/btn_drive_user1"
            app:drawableStartCompat="@drawable/ic_drive_user1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/selector_group_bg"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_drive_user2"
        style="@style/style_mode_item"
        android:paddingHorizontal="@dimen/c50_mode_item_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btn_drive_left"
        app:layout_constraintTop_toBottomOf="@+id/btn_drive_user1">

        <TextView
            style="@style/rbtn_mode_type"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/btn_drive_user2"
            app:drawableStartCompat="@drawable/ic_drive_user2" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:src="@drawable/selector_group_bg"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_loudness_switch"
        android:layout_width="0dp"
        android:layout_height="@dimen/c50_loudness_height"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="25dp"
        android:background="@drawable/shape_switch_bg"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/iv_position"
        app:layout_constraintEnd_toEndOf="@+id/tv_default"
        app:layout_constraintStart_toStartOf="@+id/tv_default">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="@string/loudness_switch"
            android:textColor="#0D0D0D"
            android:textSize="@dimen/c50_text_size"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sb_loudness"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="35dp"
            android:thumb="@drawable/ic_switch_button"
            app:track="@drawable/selector_loudness_switch"
            tools:checked="false"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_position"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="15dp"
        android:src="@drawable/position_bg"
        app:layout_constraintBottom_toTopOf="@+id/tv_default"
        app:layout_constraintDimensionRatio="H,328:285"
        app:layout_constraintEnd_toEndOf="@+id/tv_default"
        app:layout_constraintStart_toStartOf="@+id/tv_default" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_bg"
        android:padding="10dp"
        android:gravity="center"
        android:text="@string/focus"
        android:textColor="#5E718D"
        android:textSize="@dimen/c50_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/iv_position"
        app:layout_constraintEnd_toEndOf="@+id/iv_position"
        app:layout_constraintStart_toStartOf="@+id/iv_position"
        app:layout_constraintTop_toTopOf="@+id/iv_position" />

    <ImageButton
        android:id="@+id/dsp_sound_up"
        style="@style/aps_sound_image_style1"
        android:padding="15dp"
        android:src="@drawable/arrow_up"
        app:layout_constraintEnd_toEndOf="@+id/iv_position"
        app:layout_constraintStart_toStartOf="@+id/iv_position"
        app:layout_constraintTop_toTopOf="@+id/iv_position" />

    <ImageView
        android:id="@+id/iv_chair"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_sound_car"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,353:529"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/aps_sound_range"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_chair"
        app:layout_constraintEnd_toEndOf="@+id/iv_chair"
        app:layout_constraintStart_toStartOf="@+id/iv_chair"
        app:layout_constraintTop_toTopOf="@+id/iv_chair">

        <ImageView
            android:id="@+id/aps_car_ball"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:layout_gravity="center"
            android:background="@drawable/fg_soundwave"
            app:layout_constraintBottom_toBottomOf="@+id/iv_chair"
            app:layout_constraintEnd_toEndOf="@+id/iv_chair"
            app:layout_constraintStart_toStartOf="@+id/iv_chair"
            app:layout_constraintTop_toTopOf="@+id/iv_chair" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/dsp_sound_down"
        style="@style/aps_sound_image_style1"
        android:layout_centerHorizontal="true"
        android:padding="15dp"
        android:src="@drawable/arrow_down"
        app:layout_constraintBottom_toBottomOf="@+id/iv_position"
        app:layout_constraintEnd_toEndOf="@+id/iv_position"
        app:layout_constraintStart_toStartOf="@+id/iv_position" />

    <ImageButton
        android:id="@+id/dsp_sound_left"
        style="@style/aps_sound_image_style1"
        android:layout_centerVertical="true"
        android:padding="15dp"
        android:src="@drawable/arrow_left"
        app:layout_constraintBottom_toBottomOf="@+id/iv_position"
        app:layout_constraintStart_toStartOf="@+id/iv_position"
        app:layout_constraintTop_toTopOf="@+id/iv_position" />

    <ImageButton
        android:id="@+id/dsp_sound_right"
        style="@style/aps_sound_image_style1"
        android:layout_centerVertical="true"
        android:padding="15dp"
        android:src="@drawable/arrow_right"
        app:layout_constraintBottom_toBottomOf="@+id/iv_position"
        app:layout_constraintEnd_toEndOf="@+id/iv_position"
        app:layout_constraintTop_toTopOf="@+id/iv_position" />

    <Button
        android:id="@+id/tv_default"
        android:layout_width="@dimen/c50_panel_width"
        android:layout_height="0dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/selector_reset_bg"
        android:gravity="center"
        android:text="@string/reset_default"
        android:textColor="#5E718D"
        android:textSize="@dimen/c50_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/iv_chair"
        app:layout_constraintDimensionRatio="H,328:90"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>