<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/c50_card_margin_horizontal"
        android:layout_marginVertical="@dimen/c50_card_margin_vertical"
        android:background="@drawable/main_bg" />

    <RadioGroup
        android:id="@+id/rg_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="13dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:checkedButton="@+id/tab_eq"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg">

        <RadioButton
            android:id="@+id/tab_eq"
            android:layout_width="@dimen/c50_tab_width"
            android:layout_height="@dimen/c50_tab_height"
            android:background="@drawable/selector_tab_bg"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="@string/equalizer"
            android:textColor="@color/selector_tab_txt"
            android:textSize="@dimen/c50_tab_text_size" />

        <RadioButton
            android:id="@+id/tab_ball"
            android:layout_width="@dimen/c50_tab_width"
            android:layout_height="@dimen/c50_tab_height"
            android:layout_marginStart="20dp"
            android:background="@drawable/selector_tab_bg"
            android:button="@null"
            android:gravity="center"
            android:text="@string/sound_field_location"
            android:textColor="@color/selector_tab_txt"
            android:textSize="@dimen/c50_tab_text_size" />
    </RadioGroup>

    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>
